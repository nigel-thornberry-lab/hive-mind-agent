{
  "name": "hivemind-routing-bot",
  "version": "0.1.0",
  "description": "Chain-listening bot that responds to routing requests with top-3 member matches via PFT Chatbot MCP",
  "type": "module",
  "main": "dist/src/bot-loop.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/bot-loop.js",
    "mcp:server": "node dist/src/mcp-server-with-routing.js",
    "dev": "tsx src/bot-loop.ts",
    "test": "node --test dist/test/*.test.js",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@postfiatorg/pft-chatbot-mcp": "^0.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
